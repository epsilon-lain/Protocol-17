# Protocol 17 environment configuration
# Copy this file to .p17.env and fill in your values.
# .p17.env is git-ignored — it will never be committed.
#
# Precedence: values in .p17.env override the Extension Host process.env
# because .p17.env is explicit for this workspace.

P17_API_URL=http://localhost:11434/v1
P17_API_KEY=ollama
P17_MODEL=qwen3:4b-instruct
