{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Protocol 17",
  "scopeName": "source.p17",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.p17",
          "match": "//.*$"
        },
        {
          "name": "comment.block.p17",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.p17",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.p17",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.p17",
          "match": "\\b(if|else|for|while|do|return|break|continue|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.p17",
          "match": "\\b(input|output|print|read|write|main|function|from|to|in)\\b"
        },
        {
          "name": "support.function.p17",
          "match": "\\b(printf|scanf|fgets|fputs|malloc|free|sizeof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.p17",
          "match": "\\b(int|float|double|char|void|long|short|string|bool|auto|const|struct|enum|unsigned|signed)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.p17",
          "match": "\\b(true|false|null|NULL)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.p17",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?[fFlL]?\\b"
        },
        {
          "name": "constant.numeric.hex.p17",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.p17",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.p17",
          "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.comparison.p17",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.p17",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.p17",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.p17",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    }
  }
}
